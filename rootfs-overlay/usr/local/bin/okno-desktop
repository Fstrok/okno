#!/bin/sh
# Starts XFCE for the Okno app on the X server it runs on the Android side
# (Termux:X11, see LinuxService.startDesktop): its socket is in /tmp/.X11-unix.
#   okno-desktop :DISPLAY
export DISPLAY=${1:-:1}
export HOME=/root USER=root LOGNAME=root SHELL=/bin/bash
export LANG=ru_RU.UTF-8 LANGUAGE=ru_RU:ru
export XDG_RUNTIME_DIR=/tmp/runtime-root XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE
export NO_AT_BRIDGE=1
# Firefox's sandboxes rely on seccomp and namespaces that clash with proot.
export MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 MOZ_DISABLE_UTILITY_SANDBOX=1

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
# A session from an earlier run may have outlived its proot.
pkill -x xfce4-session 2>/dev/null
rm -f /root/.ICEauthority

i=0
while [ ! -S "/tmp/.X11-unix/X${DISPLAY#:}" ] && [ $i -lt 300 ]; do
  sleep 0.1
  i=$((i + 1))
done
echo "okno-desktop: display $DISPLAY"

# Latin and Russian on the same keys (levels 1-2 / 3-4, see the okno XKB
# layout): text typed on the phone finds its letters in the keymap.
setxkbmap -layout okno

# Keeps windows inside the screen and opens big ones maximized (phone screen).
okno-wm-guard &
# After an in-place system update: installs packages the new version needs.
okno-system-update &

exec dbus-launch --exit-with-session startxfce4
