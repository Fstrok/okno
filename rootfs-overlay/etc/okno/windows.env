# Okno: settings for Windows programs (sourced by okno-app windows).
# Speed comes first; if a program misbehaves, the safer values are noted.

# Emulators (Hangover's defaults, spelled out): 64-bit x86 programs run
# through FEX (ARM64EC), 32-bit ones through Box64 inside Wine's WoW64.
export HODLL64=libarm64ecfex.dll
export HODLL=wowbox64.dll

# Box64: the "fast" set of dynarec shortcuts (safer: default or safe).
export BOX64_PROFILE=fast
export BOX64_NOBANNER=1 BOX64_LOG=0

# FEX: x87 floating point in 64-bit doubles instead of 80-bit (old programs
# and games use x87 a lot; safer: 0). Memory ordering (TSO) stays on:
# without it nearly every multithreaded program breaks.
export FEX_X87REDUCEDPRECISION=1

# No debug output: Wine's tracing costs time even when nobody reads it.
export WINEDEBUG=-all
